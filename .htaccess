# ── Clean URLs: hide .html extensions ─────────────────────────────
# /admin  ->  /admin.html   (and any other page)
RewriteEngine On

# Serve file.html when requested without the extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Optionally redirect old .html URLs to the clean version (nice for SEO/shares)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve index.html automatically at /
DirectoryIndex index.html

# Canonical: /index.html -> / (clean root URL, keeps query string like ?c=...)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L,QSA]